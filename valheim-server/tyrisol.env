SERVER_NAME="<b><#CCFFFF>Tyrisol</b>"
WORLD_NAME=Tyrisol
# this would normally have a SERVER_PASS= env entry, but i can't exactly publish that.

SERVER_PUBLIC=true       # discovery is fine, the server has a password.

BACKUPS=false            # we manually back things up with server-side infra stuff!

UPDATE_CRON=*/15 * * * * # this is the default, should be fine....
UPDATE_IF_IDLE=TRUE      # why not, it's also the default value.

TZ=America/Chicago

SERVER_ARGS="-modifier resources muchmore -modifier deathpenalty easy"

